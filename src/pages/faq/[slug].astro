---
import { getCollection, getEntry } from 'astro:content';

import { URL_PREFIX } from '../../shared/config';
import Layout from '../../shared/layout/base-layout.astro';
import { getFirstLevelStaticPathsFromCollection } from '../../shared/utilities';
import FaqItem from './_item.component.astro';

export async function getStaticPaths() {
  return await getFirstLevelStaticPathsFromCollection('vendors');
}

const { slug } = Astro.params;
if (!slug) throw new Error('Missing slug param');
const vendor = await getEntry('vendors', slug);
if (!vendor) throw new Error(`Missing vendor: ${slug}`);
const entries = await getCollection('faq', (entry) => entry.id.startsWith(slug));
---

<Layout title=`Frequently Asked Questions for ${vendor.data.name}`>
  <div class="prose dark:prose-invert mb-12 max-w-none">
    <p>
      Looking for which firmware to install before which? That moved to{' '}
      <a href={`${URL_PREFIX}upgrade-path/${vendor.id}`}>upgrade paths</a>.
    </p>
  </div>

  <div class="space-y-16">
    {
      entries.length > 0 ? (
        entries.map((entry) => <FaqItem slug={entry.id} />)
      ) : (
        <p>We don't have any FAQs for this vendor yet.</p>
      )
    }
  </div>
</Layout>
