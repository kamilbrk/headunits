---
import type { CollectionEntry } from 'astro:content';

import { Image } from 'astro:assets';

import { URL_PREFIX } from '../../shared/config';
import { getVendorSlug } from '../../shared/utilities';

interface Props {
  theme: CollectionEntry<'themes'>;
  /**
  Label the card with its vendor, for grids that mix both.
  */
  showVendor?: boolean;
}
const { theme, showVendor = false } = Astro.props;
const tagClassNames = theme.data.tags?.map((x) => `tag--${x}`).join(' ');
const name = theme.data.display || theme.data.id;
const vendor = showVendor ? getVendorSlug(theme.id).toUpperCase() : undefined;
---

<div class={`group relative ${tagClassNames}`}>
  <div class="w-full overflow-hidden rounded-md group-hover:opacity-75">
    {
      theme.data.images?.[0] ? (
        <Image
          src={theme.data.images[0]}
          alt={`Screenshot of the ${name} theme`}
          layout="constrained"
          widths={[400, 800, 1200]}
          sizes="(min-width: 1280px) 33vw, (min-width: 640px) 50vw, 100vw"
          transition:name={`theme-${theme.id}`}
        />
      ) : (
        <div
          class="flex aspect-1920/720 items-center justify-center bg-gray-100 px-4 text-center text-sm text-gray-500 dark:bg-gray-800 dark:text-gray-400"
          role="img"
          aria-label={`No screenshot available for the ${name} theme`}
        >
          <span>No screenshot yet</span>
        </div>
      )
    }
  </div>
  <div class="mt-4">
    <h3 class="text-sm text-gray-700 dark:text-gray-300">
      <a href={`${URL_PREFIX}${theme.collection}/${theme.id}`}>
        <span aria-hidden="true" class="absolute inset-0"></span>
        {vendor && <span>{vendor} </span>}
        {theme.data.number && <span>ID#{theme.data.number} - </span>}
        {theme.data.id}
      </a>
    </h3>
    <p class="mt-1 text-sm text-gray-500">{theme.data.tags?.map((tag) => <span>#{tag} </span>)}</p>
  </div>
</div>
