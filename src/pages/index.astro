---
import { Image } from 'astro:assets';

import { URL_PREFIX } from '../shared/config';
import Layout from '../shared/layout/base-layout.astro';
import homePicture from '../shared/pic.jpg';
import UnitFinder from '../shared/unit-finder.component.astro';
import { getLatestUpdates } from '../shared/utilities';
import UpdatesListItem from './updates/_list-item.component.astro';

const LATEST_UPDATE_COUNT = 6;
const latestUpdates = await getLatestUpdates(LATEST_UPDATE_COUNT);
---

<Layout>
  <div class="prose dark:prose-invert break-words">
    <p class="text-lg leading-8">
      Community-driven information site about third-party replacement car screens running Android
      software from KSW and ZXW vendors, for car brands like Audi, Benz, BMW, Mini and others.
    </p>
    <p>
      Read about changes found in latest firmware updates, browse through available themes and more.
      Start below, or pick a section from the menu.
    </p>
    <p>
      Join the conversation on <a href="https://discord.gg/Ex8e6qE2eR"
        >Android Automotive Headunits Discord</a
      > or various forums like <a href="https://f30.bimmerpost.com/forums/showthread.php?t=1832178"
        >Bimmerpost and its Android 11/12/13 thread</a
      >.
    </p>
  </div>
  <Image
    class="mt-12 rounded-md"
    src={homePicture}
    alt="Aftermarket Android head unit installed in a car dashboard"
    layout="full-width"
    loading="eager"
    fetchpriority="high"
  />

  <div class="mt-12">
    <UnitFinder />
  </div>

  <div class="prose dark:prose-invert mt-12 max-w-none break-words">
    <h3>Latest firmware</h3>
    <ul>
      {latestUpdates.map((entry) => <UpdatesListItem entry={entry} showPlatform />)}
    </ul>
    <p>
      <a href={`${URL_PREFIX}updates`}>All firmware updates</a>
      {' · '}
      <a href={`${URL_PREFIX}platforms`}>All platforms</a>
    </p>
  </div>
</Layout>
