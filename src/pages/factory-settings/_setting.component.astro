---
import type { SettingItem } from '../../data/factory-settings';

import CodeBracket from 'astro-heroicons/outline/CodeBracket.astro';
import { slug } from 'github-slugger';

interface Props {
  section: string;
  setting: SettingItem;
  parentSetting?: SettingItem;
}

const { section, setting, parentSetting } = Astro.props;

const uniqueId = slug([section, parentSetting?.name, setting.name].filter(Boolean).join(' '));

// A radio belongs to its parent's key: the group names the element, each
// child names one value of it.
const configKey =
  setting.configKey ?? (setting.control === 'radio' ? parentSetting?.configKey : undefined);
const editable = setting.editable !== false && parentSetting?.editable !== false;

let configXmlRef;

if (setting.configValue !== undefined) {
  configXmlRef = `Value for the setting above in factory config file should be "${setting.configValue}"`;
} else if (setting.configKey) {
  configXmlRef = `This setting can be found and set in factory config file with key "${setting.configKey}"`;

  if (setting.control === 'checkbox' && !setting.children) {
    configXmlRef += `\n\nAdditionally, the values will be most likely "0" or "1" to indicate disabled/enabled state.`;
  }
}
---

<div
  data-setting
  data-config-key={configKey}
  data-control={setting.control}
  data-value-type={setting.valueType}
  data-on-value={setting.onValue}
  data-off-value={setting.offValue}
  data-config-value={setting.configValue}
  data-editable={editable && configKey ? undefined : 'false'}
>
  <div class="flex items-center space-x-2">
    {
      setting.control === 'checkbox' && (
        <input
          type="checkbox"
          disabled
          tabindex="-1"
          aria-hidden="true"
          class="h-4 w-4 rounded-sm border-gray-300 text-indigo-600 focus:ring-indigo-500"
        />
      )
    }

    {
      setting.control === 'radio' && (
        <input
          type="radio"
          disabled
          tabindex="-1"
          aria-hidden="true"
          class="h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-500"
        />
      )
    }

    <span id={uniqueId} title={setting.nameOld ? `Old name: ${setting.nameOld}` : undefined}>
      {setting.name}
    </span>

    {
      setting.max && (
        <>
          <input
            type="range"
            min={setting.min}
            max={setting.max}
            disabled
            tabindex="-1"
            aria-hidden="true"
            class="h-2 cursor-pointer appearance-none rounded-lg bg-gray-300 dark:bg-gray-700"
          />
          <span>
            ({setting.min} - {setting.max})
          </span>
        </>
      )
    }

    {
      configXmlRef && (
        <span
          class="mt-0.5 flex items-center text-xs text-gray-600 dark:text-gray-400"
          title={configXmlRef}
        >
          &lpar;
          <CodeBracket class="mt-0.5 mr-1 inline h-3 w-3" />
          <code class="not-prose mt-0.5">{setting.configKey || setting.configValue}</code> &rpar;
        </span>
      )
    }

    <span
      hidden
      data-setting-note
      class="text-xs text-gray-500 italic dark:text-gray-400"
      class:list={{ 'ml-6': setting.control === 'checkbox' || setting.control === 'radio' }}></span>
  </div>

  {
    setting.description && (
      <div
        class="mb-1 text-sm text-gray-600 dark:text-gray-400"
        class:list={{ 'ml-6': setting.control === 'checkbox' || setting.control === 'radio' }}
      >
        {setting.description}
      </div>
    )
  }

  {
    setting.warning && (
      <aside
        class="callout callout--warning not-prose text-sm"
        class:list={{ 'ml-6': setting.control === 'checkbox' || setting.control === 'radio' }}
        role="note"
      >
        <p class="callout__label">Warning</p>
        <p>{setting.warning}</p>
      </aside>
    )
  }

  {
    setting.children?.map((child) => (
      <Astro.self section={section} setting={child} parentSetting={setting} />
    ))
  }
</div>
