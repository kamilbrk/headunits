---
import { Code } from 'astro:components';
import { getCollection, getEntry } from 'astro:content';

import { SHIKI_THEMES, URL_PREFIX } from '../../shared/config';
import { validateConfigKeys } from '../../shared/factory-config/validate-keys';
import Layout from '../../shared/layout/base-layout.astro';
import { getFirstLevelStaticPathsFromCollection, sortEntriesById } from '../../shared/utilities';
import FactoryConfigBuilder from './_builder.component.astro';
import FactorySettingsSection from './_section.component.astro';

export async function getStaticPaths() {
  return await getFirstLevelStaticPathsFromCollection('vendors');
}

const { slug } = Astro.params;
if (!slug) throw new Error('Missing slug param');
const vendor = await getEntry('vendors', slug);
if (!vendor) throw new Error(`Missing vendor: ${slug}`);
const entries = await getCollection('factory-settings', (entry) => entry.id.startsWith(slug));

const xmls = import.meta.glob<string>('/public/*.xml', {
  query: '?raw',
  import: 'default',
  eager: true
});
const xml = xmls[`/public/${vendor.data.factoryConfigFileName}`];

// Build-time gate: every documented key has to name something the real file
// carries. Runs here because this is the one place the settings and the
// example file already meet.
if (xml) {
  for (const entry of entries) {
    validateConfigKeys(slug, entry.data.settings ?? [], xml);
  }
}
---

<Layout title=`Factory settings for ${vendor.data.name}`>
  <article class="prose dark:prose-invert">
    {
      vendor.data.factoryConfigFileName && (
        <FactoryConfigBuilder vendor={vendor.id} fileName={vendor.data.factoryConfigFileName} />
      )
    }

    {
      entries.length > 0 ? (
        entries.sort(sortEntriesById).map((entry) => <FactorySettingsSection slug={entry.id} />)
      ) : (
        <p>We don't have any descriptions for factory settings for this vendor yet.</p>
      )
    }
  </article>

  {
    xml && (
      <>
        <article class="prose dark:prose-invert">
          <h3 data-listing-heading>
            An example <code>{vendor.data.factoryConfigFileName}</code> file
          </h3>
          <p data-listing-intro>
            Please{' '}
            <a href={`${URL_PREFIX}faq/${vendor.id}/pull-factory-config`}>
              make a backup for your original file
            </a>{' '}
            first. Then make adjustments to your own file with parts from the following example and
            finally follow{' '}
            <a href={`${URL_PREFIX}faq/${vendor.id}/apply-factory-config`}>
              instructions to import it to your Head Unit
            </a>
            .
          </p>
          <p data-listing-yours hidden>
            Your own file, with your changes. Copy it over your{' '}
            <code>{vendor.data.factoryConfigFileName}</code>, keeping the backup you made, then
            follow{' '}
            <a href={`${URL_PREFIX}faq/${vendor.id}/apply-factory-config`}>
              instructions to import it to your Head Unit
            </a>
            .
          </p>
          <button
            data-listing-copy
            type="button"
            hidden
            class="not-prose rounded-md border border-gray-300 px-3 py-1.5 text-sm font-medium hover:bg-gray-50 dark:border-gray-600 dark:hover:bg-gray-800"
          >
            Copy the whole file
          </button>
        </article>
        {/* The builder swaps the text inside this block for the reader's own
            file, so it keeps the Shiki block's colours, padding and scrolling
            and only loses the highlighting. */}
        <div data-listing-code>
          <Code
            class="-mx-4 mt-4 p-4 sm:-mx-6 sm:mt-6 sm:p-6 lg:-mx-8 lg:mt-8 lg:p-8"
            lang="xml"
            code={xml}
            themes={SHIKI_THEMES}
          />
        </div>
      </>
    )
  }
</Layout>
