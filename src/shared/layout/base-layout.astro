---
import './tailwind.css';
import './global.css';

import { ClientRouter } from 'astro:transitions';

import { DEFAULT_PAGE_DESCRIPTION, DEFAULT_PAGE_TITLE, DOMAIN, URL_PREFIX } from '../config';
import ColorSchemeBootstrap from './color-scheme-bootstrap.component.astro';
import Navigation from './navigation.component.astro';

export interface Props {
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Extra Pagefind facets for this page, on top of the ones read from the URL.
   */
  filters?: Record<string, string | number | undefined>;
  /**
   * Whether this page belongs in the search index. The 404 and search pages
   * have no content worth returning, and indexing them puts `404` and
   * `search` into the section facet as selectable values.
   */
  indexed?: boolean;
}

const {
  title: pageTitle,
  description: pageDescription,
  jsonLd: pageJsonLd,
  filters: pageFilters,
  indexed = true
} = Astro.props;
const title = pageTitle || DEFAULT_PAGE_TITLE;
const description = pageDescription || DEFAULT_PAGE_DESCRIPTION;
const canonicalUrl = new URL(Astro.url.pathname, DOMAIN);
const rssUrl = new URL(`${URL_PREFIX}rss.xml`, DOMAIN).href;

// Section and vendor come straight from the route, so every page is filterable
// in search without each one having to declare them.
const [section, vendor] = Astro.url.pathname.slice(URL_PREFIX.length).split('/', 2);
const pagefindFilters = Object.entries({ section, vendor, ...pageFilters }).filter(
  ([, value]) => value !== undefined && value !== ''
);
const ogImageUrl = new URL(`${URL_PREFIX}og-image.jpg`, DOMAIN).href;

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: DEFAULT_PAGE_TITLE,
  url: new URL(URL_PREFIX, DOMAIN).href,
  description: DEFAULT_PAGE_DESCRIPTION
};
const jsonLdBlocks = [
  websiteJsonLd,
  ...(Array.isArray(pageJsonLd) ? pageJsonLd : pageJsonLd ? [pageJsonLd] : [])
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <ColorSchemeBootstrap />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="sitemap" type="application/xml" href={`${URL_PREFIX}sitemap-index.xml`} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${DEFAULT_PAGE_TITLE} — firmware updates`}
      href={rssUrl}
    />
    <link rel="preconnect" href="https://cloud.umami.is" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:site_name" content={DEFAULT_PAGE_TITLE} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="458" />
    <meta property="og:image:alt" content={DEFAULT_PAGE_TITLE} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {
      jsonLdBlocks.map((block) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }

    <ClientRouter />

    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="e0f4a738-aa45-4891-b409-772c495cb8b2"></script>
  </head>
  <body class="bg-white dark:bg-gray-900">
    <Navigation title={title} />

    <main
      class="max-w-(--breakpoint-2xl) pt-8 pb-24 lg:pl-72"
      data-pagefind-body={indexed || undefined}
    >
      {
        /* One element per facet: Pagefind reads a single `key:value` per
           attribute and treats a comma-separated list as one literal value. */
        indexed &&
          pagefindFilters.map(([key, value]) => (
            <div hidden data-pagefind-filter={`${key}:${value}`} />
          ))
      }
      <div class="px-4 sm:px-6 lg:px-8">
        {
          title !== DEFAULT_PAGE_TITLE && (
            <h2
              class="pb-8 text-2xl leading-7 font-bold text-gray-900 sm:text-3xl sm:tracking-tight dark:text-white"
              data-pagefind-meta="title"
              data-pagefind-weight="100"
            >
              {title}
            </h2>
          )
        }
        <slot />
      </div>
    </main>

    <div
      class="fixed inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]"
      aria-hidden="true"
    >
      <div
        class="relative left-[calc(50%+3rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 bg-linear-to-tr from-[#ff80b5] to-[#9089fc] opacity-30 sm:left-[calc(50%+36rem)] sm:w-[72.1875rem]"
        style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
      >
      </div>
    </div>
  </body>
</html>
