---
import type { LinkOrText } from './utilities';

import LinkOrTextComponent from './link-or-text.component.astro';

interface Props {
  items: LinkOrText[];
}

const { items } = Astro.props;
const head = items.slice(0, -1);
const last = items.at(-1);
---

<>
  {
    head.map((item, index) => (
      <>
        <LinkOrTextComponent item={item} />
        {index < head.length - 1 && ', '}
      </>
    ))
  }{head.length > 0 && ' and '}{last !== undefined && <LinkOrTextComponent item={last} />}
</>
