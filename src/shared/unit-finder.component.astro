---
import { getCollection } from 'astro:content';

import { URL_PREFIX } from './config';

const vendors = await getCollection('vendors');
---

<div class="not-prose rounded-md border border-gray-200 p-4 dark:border-gray-700">
  <h3 class="text-base font-semibold text-gray-900 dark:text-white">Which unit do I have?</h3>
  <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
    The build number in Android settings starts with your platform name. Match it against the
    platform list for your vendor.
  </p>
  <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
    {
      vendors.map((vendor) => (
        <li>
          <a
            class="font-semibold text-indigo-600 hover:underline dark:text-indigo-400"
            href={`${URL_PREFIX}platforms/${vendor.id}`}
          >
            {vendor.data.name} platforms
          </a>
        </li>
      ))
    }
  </ul>
</div>
